        'nv-gray-100': '#F2F3F8',
        'nv-gray-700': '#4A4A4A',

        // Additional colors
        'nv-success': '#28a745',
        'nv-error': '#dc3545'
      },
      fontFamily: {
        'gilroy': ['Gilroy', 'sans-serif'],
        'sans': ['Gilroy', 'ui-sans-serif', 'system-ui', '-apple-system', 'BlinkMacSystemFont', 'Segoe UI', 'Roboto', 'Helvetica Neue', 'Arial', 'sans-serif'],
      },
      spacing: {
        // 4px scale increments
        4: '1rem',
        8: '2rem',
        12: '3rem',
        16: '4rem',
        20: '5rem',
        24: '6rem',
      },
      borderRadius: {
        'md': '6px',
        'lg': '8px',
        'xl': '12px',
        '2xl': '16px',
      },
      boxShadow: {
        // Subtle shadow for cards, modals, etc.
        'md': '0 4px 6px rgba(0,0,0,0.1)',
      },
      transitionProperty: {
        'height': 'height',
        'spacing': 'margin, padding',
      },
      typography: {
        DEFAULT: {
          css: {
            color: '#333',
